using System.Collections;
using UnityEngine;

public class AttackMenuManager : MonoBehaviour
{
    public NetworkManager networkManager; // اسحب مرجع الـ NetworkManager هنا

    // دالة بتشتغل أول ما تفتح شاشة الهجوم أو تضغط زرار البحث عن خصوم
    public void OnOpenAttackMenu()
    {
        StartCoroutine(FetchPlayers());
    }

    IEnumerator FetchPlayers()
    {
        yield return StartCoroutine(networkManager.GetPlayersList((jsonResponse) => {
            if (!string.IsNullOrEmpty(jsonResponse))
            {
                Debug.Log("تم استلام قائمة اللاعبين بنجاح: " + jsonResponse);
                // هنا هيتم تحويل الـ JSON لعرض الأزرار في الواجهة
            }
            else
            {
                Debug.LogError("فشل في تحميل قائمة اللاعبين من السيرفر.");
            }
        }));
    }
}
