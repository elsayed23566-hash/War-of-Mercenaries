using System.Collections;
using UnityEngine;
using UnityEngine.UI; // مهم عشان نقدر نتعامل مع الأزرار والـ UI

public class AttackMenuManager : MonoBehaviour
{
    public NetworkManager networkManager; 
    public Transform contentParent; // الـ Content اللي جوه الـ Scroll View اللي هتحط فيه الأزرار
    public GameObject playerButtonPrefab; // بريفاب زرار اللاعب اللي هيتكرر

    public void OnOpenAttackMenu()
    {
        StartCoroutine(FetchPlayers());
    }

    IEnumerator FetchPlayers()
    {
        yield return StartCoroutine(networkManager.GetPlayersList((jsonResponse) => {
            if (!string.IsNullOrEmpty(jsonResponse))
            {
                Debug.Log("تم استلام قائمة اللاعبين بنجاح: " + jsonResponse);
                
                // تفريغ الأزرار القديمة لو موجودة
                foreach (Transform child in contentParent) {
                    Destroy(child.gameObject);
                }

                // تحليل الـ JSON (هنستخدم مكتبة سريعة أو طريقة Unity لفك الـ JSON)
                // هنا بنعرض اللاعبين كأزرار
                ProcessAndSpawnButtons(jsonResponse);
            }
            else
            {
                Debug.LogError("فشل في تحميل قائمة اللاعبين من السيرفر.");
            }
        }));
    }

    void ProcessAndSpawnButtons(string jsonArray)
    {
        // بما أن الـ JSON جاي على شكل مصفوفة [ {playerId, playerName, playerLevel}, ... ]
        // هنبسط تحليلها باستخدام JsonUtility عن طريق عمل Wrapper كلاس لو حبيت،
        // أو هنعرضهم مباشرة. قولي لو جاهز نعمل كلاس الـ Wrapper الخاص بالـ List!
    }
}
